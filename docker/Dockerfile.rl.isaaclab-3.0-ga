FROM nvcr.io/nvidia/isaac-sim:6.0.1

# Omniverse runtime env (required for Kit / Isaac Sim commands in containers).
ENV ACCEPT_EULA=Y
ENV OMNI_KIT_ALLOW_ROOT=1
ENV DEBIAN_FRONTEND=noninteractive
ENV ISAACSIM_ROOT_PATH=/isaac-sim
ENV ISAACLAB_PATH=/workspace/isaaclab

ARG ISAACLAB_REPO=https://github.com/isaac-sim/IsaacLab.git
ARG ISAACLAB_REF=20976357cce6498d4f3db91b18540f3969c84247

USER root

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    git-lfs \
    libglib2.0-0 \
    ncurses-term \
    wget \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Build a self-contained Isaac Lab layer because an NGC isaac-lab image for this
# newer stack may not exist yet. ISAACLAB_REF is pinned for reproducibility; it
# can still be overridden with a branch, tag, or commit at docker build time.
RUN git clone "${ISAACLAB_REPO}" "${ISAACLAB_PATH}" \
 && cd "${ISAACLAB_PATH}" \
 && git -c advice.detachedHead=false checkout "${ISAACLAB_REF}" \
 && chmod +x isaaclab.sh \
 && ln -sf "${ISAACSIM_ROOT_PATH}" "${ISAACLAB_PATH}/_isaac_sim" \
 && if [ -f docker/scripts/install_carb_env_shim.sh ]; then \
      /bin/bash docker/scripts/install_carb_env_shim.sh "${ISAACSIM_ROOT_PATH}"; \
    fi \
 && ./isaaclab.sh -p -m pip install toml pytest \
 && ./isaaclab.sh -p "${ISAACLAB_PATH}/tools/install_deps.py" apt "${ISAACLAB_PATH}/source" \
 && apt-get -y autoremove \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* \
 && ./isaaclab.sh --install

# COMPASS lives in /workspace/COMPASS so /workspace/isaaclab remains available
# for both OSMO jobs and local docker/run.sh usage.
WORKDIR /workspace/COMPASS

COPY . /workspace/COMPASS

# Install COMPASS dependencies, the X-Mobility wheel, and the mobility_es Isaac
# Lab extension into Isaac Lab's bundled Python environment.
RUN ${ISAACLAB_PATH}/isaaclab.sh -p -m pip install -r /workspace/COMPASS/requirements.txt \
 && ${ISAACLAB_PATH}/isaaclab.sh -p -m pip install /workspace/COMPASS/x_mobility/x_mobility-0.1.0-py3-none-any.whl \
 && ${ISAACLAB_PATH}/isaaclab.sh -p -m pip install -e /workspace/COMPASS/compass/rl_env/exts/mobility_es

# Provide python/python3 on PATH for docker/run.sh exec and direct container use.
RUN printf '#!/usr/bin/env bash\nexec "${ISAACLAB_PATH}/_isaac_sim/python.sh" "$@"\n' \
        > /usr/local/bin/python \
 && chmod +x /usr/local/bin/python \
 && ln -sf /usr/local/bin/python /usr/local/bin/python3
